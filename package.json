{
  "name": "@swisstokint/open-risk-infrastructure",
  "version": "0.1.0",
  "private": false,
  "description": "Deterministic and inspectable market-risk rule evaluation.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:risk": "npm run build && node --test dist/**/*.test.js",
    "test:proof": "node --test tests/*.node.test.mjs && python -m unittest sdk/python/test_swisstokint_proof.py",
    "filecoin:build": "node scripts/build-filecoin-bundle.mjs",
    "filecoin:verify": "node scripts/verify-filecoin-bundle.mjs",
    "solana:keygen": "node scripts/solana-devnet-anchor.mjs keygen",
    "solana:dry-run": "node scripts/solana-devnet-anchor.mjs dry-run",
    "solana:publish": "node scripts/solana-devnet-anchor.mjs publish",
    "solana:verify": "node scripts/solana-devnet-anchor.mjs verify",
    "test": "npm run test:risk && npm run test:proof"
  },
  "license": "(MIT OR Apache-2.0)",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@ipld/car": "^5.4.6",
    "@solana-program/memo": "0.12.0",
    "@solana/kit": "7.0.0",
    "@solana/kit-plugin-rpc": "0.15.0",
    "@solana/kit-plugin-signer": "0.13.0",
    "multiformats": "^14.0.5"
  }
}
