{
  "name": "@swisstokint/open-risk-infrastructure",
  "version": "0.1.0",
  "private": false,
  "description": "Deterministic and inspectable market-risk rule evaluation.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:risk": "npm run build && node --test dist/**/*.test.js",
    "test:proof": "node --test tests/proof-sdk.node.test.mjs && python -m unittest sdk/python/test_swisstokint_proof.py",
    "test": "npm run test:risk && npm run test:proof"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4"
  }
}
