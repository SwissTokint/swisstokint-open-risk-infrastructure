{
  "name": "@swisstokint/open-risk-infrastructure",
  "version": "0.1.1",
  "private": false,
  "description": "Deterministic and inspectable market-risk rule evaluation.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:risk": "npm run build && node --test dist/**/*.test.js",
    "test:pom-rx": "node --test tests/pom-rx.node.test.mjs",
    "test:pom-rx:action-continuity": "node --test tests/pom-rx-v01-action-continuity.node.test.mjs",
    "test:pom-rx:input-continuity": "node --test tests/pom-rx-v01-input-continuity.node.test.mjs",
    "test:pom-rx:execution-assertion-consistency": "node --test tests/pom-rx-v01-execution-assertion-consistency.node.test.mjs",
    "test:pom-rx:reconciliation-assertion-consistency": "node --test tests/pom-rx-v01-reconciliation-assertion-consistency.node.test.mjs",
    "test:pom-rx:receipt-id-uniqueness": "node --test tests/pom-rx-v01-receipt-id-uniqueness.node.test.mjs",
    "test:pom-rx:strict-activation": "node --test tests/pom-rx-v01-strict-activation.node.test.mjs",
    "test:pom-rx:artifact-scanner-regression": "node --test tests/pom-rx-v01-artifact-scanner-regression.node.test.mjs",
    "test:pom-rx:core-reference-gate": "node --test tests/pom-rx-core-reference-gate.node.test.mjs",
    "test:pom-rx:wallet-guard-intent-policy": "node --test tests/wallet-guard/intent-policy.node.test.mjs",
    "test:pom-rx:wallet-guard-provider-gate": "node --test tests/wallet-guard/provider-gate.node.test.mjs",
    "test:pom-rx:wallet-guard-controlled-host": "node --test tests/wallet-guard/controlled-host.node.test.mjs",
    "test:pom-rx:repository-layout": "node --test tests/pom-rx-repository-layout.node.test.mjs",
    "test:pom-rx:capability-map": "node --test tests/pom-rx-capability-map.node.test.mjs",
    "test:pom-rx:post-merge-assurance": "node --test tests/pom-rx-post-merge-assurance-policy.node.test.mjs",
    "test:pom-rx:integrity-baseline": "node --test tests/pom-rx-integrity-baseline.node.test.mjs",
    "test:pom-rx:integrity-baseline:expected-red": "node scripts/assert-pom-rx-integrity-baseline-red.mjs",
    "test:pom-rx:profile-foundation": "node --test tests/pom-rx-v01-profile-foundation.node.test.mjs",
    "test:pom-rx:witness-primitives": "node --test tests/pom-rx-witness-primitives.node.test.mjs",
    "test:pom-rx:v01-fixtures": "node --test tests/pom-rx-v01-compat-fixtures.node.test.mjs",
    "test:public-identity": "node --test tests/public-identity.node.test.mjs",
    "test:proof-receipt": "node --test tests/proof-sdk.node.test.mjs && python -m unittest sdk/python/test_swisstokint_proof.py",
    "test:proof-integrations": "node --test tests/filecoin-evidence-bundle.node.test.mjs tests/proof-relay.node.test.mjs",
    "test:proof": "npm run test:pom-rx && npm run test:proof-receipt && npm run test:proof-integrations",
    "filecoin:build": "node scripts/build-filecoin-bundle.mjs",
    "filecoin:verify": "node scripts/verify-filecoin-bundle.mjs",
    "test": "npm run test:risk && npm run test:proof && npm run test:pom-rx:v01-fixtures && npm run test:pom-rx:profile-foundation && npm run test:pom-rx:action-continuity && npm run test:pom-rx:input-continuity && npm run test:pom-rx:execution-assertion-consistency && npm run test:pom-rx:reconciliation-assertion-consistency && npm run test:pom-rx:receipt-id-uniqueness && npm run test:pom-rx:strict-activation && npm run test:pom-rx:artifact-scanner-regression && npm run test:pom-rx:witness-primitives && npm run test:pom-rx:core-reference-gate && npm run test:pom-rx:wallet-guard-intent-policy && npm run test:pom-rx:wallet-guard-provider-gate && npm run test:pom-rx:wallet-guard-controlled-host && npm run test:pom-rx:capability-map && npm run test:pom-rx:repository-layout && npm run test:pom-rx:post-merge-assurance && npm run test:public-identity"
  },
  "license": "(MIT OR Apache-2.0)",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@ipld/car": "^5.4.7",
    "multiformats": "^14.0.5"
  }
}
