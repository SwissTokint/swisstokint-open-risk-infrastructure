{
  "name": "@swisstokint/open-risk-infrastructure",
  "version": "0.1.0",
  "private": false,
  "description": "Deterministic and inspectable market-risk rule evaluation.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:risk": "npm run build && node --test dist/**/*.test.js",
    "test:pom-rx": "node --test tests/pom-rx.node.test.mjs",
    "test:pom-rx:integrity-baseline": "node --test tests/pom-rx-integrity-baseline.node.test.mjs",
    "test:pom-rx:integrity-baseline:expected-red": "node scripts/assert-pom-rx-integrity-baseline-red.mjs",
    "test:proof-receipt": "node --test tests/proof-sdk.node.test.mjs && python -m unittest sdk/python/test_swisstokint_proof.py",
    "test:proof-integrations": "node --test tests/filecoin-evidence-bundle.node.test.mjs tests/proof-relay.node.test.mjs",
    "test:proof": "npm run test:pom-rx && npm run test:proof-receipt && npm run test:proof-integrations",
    "filecoin:build": "node scripts/build-filecoin-bundle.mjs",
    "filecoin:verify": "node scripts/verify-filecoin-bundle.mjs",
    "test": "npm run test:risk && npm run test:proof"
  },
  "license": "(MIT OR Apache-2.0)",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@ipld/car": "^5.4.6",
    "multiformats": "^14.0.5"
  }
}
