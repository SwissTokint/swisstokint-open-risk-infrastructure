{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swisstokint.ch/schemas/filecoin-receipt-proof-v0.1.schema.json",
  "title": "SwissTokint Filecoin Receipt Proof Block v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_ref",
    "merkle_root",
    "receipt_id",
    "commitment_hash",
    "occurred_at",
    "leaf_index",
    "leaf_hash",
    "proof"
  ],
  "properties": {
    "schema_version": { "const": "pom-receipt-proof/0.1" },
    "batch_ref": { "type": "string", "pattern": "^pom-[a-f0-9]{24}$" },
    "merkle_root": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{15,127}$"
    },
    "commitment_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "leaf_index": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "leaf_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proof": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position", "hash"],
        "properties": {
          "position": { "enum": ["left", "right"] },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
