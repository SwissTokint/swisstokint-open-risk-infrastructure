{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swisstokint.ch/schemas/proof-batch-v0.1.schema.json",
  "title": "SwissTokint Proof Batch v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tree_algorithm",
    "ordering",
    "batch_ref",
    "leaf_count",
    "merkle_root",
    "leaves"
  ],
  "properties": {
    "schema_version": {
      "const": "pom-batch/0.1"
    },
    "tree_algorithm": {
      "const": "sha256-domain-separated-duplicate-last"
    },
    "ordering": {
      "const": "occurred_at-asc,receipt_id-asc"
    },
    "batch_ref": {
      "type": "string",
      "pattern": "^pom-[a-f0-9]{24}$"
    },
    "leaf_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "merkle_root": {
      "$ref": "#/$defs/sha256"
    },
    "leaves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/leaf"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "commitment_hash",
        "occurred_at",
        "leaf_index",
        "leaf_hash",
        "proof"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{15,127}$"
        },
        "commitment_hash": {
          "$ref": "#/$defs/sha256"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "leaf_index": {
          "type": "integer",
          "minimum": 0
        },
        "leaf_hash": {
          "$ref": "#/$defs/sha256"
        },
        "proof": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "hash"],
            "properties": {
              "position": {
                "enum": ["left", "right"]
              },
              "hash": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  }
}
