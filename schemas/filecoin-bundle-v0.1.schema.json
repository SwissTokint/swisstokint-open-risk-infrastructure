{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swisstokint.ch/schemas/filecoin-bundle-v0.1.schema.json",
  "title": "SwissTokint Filecoin Evidence Bundle Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "storage_profile",
    "batch_ref",
    "merkle_root",
    "leaf_count",
    "tree_algorithm",
    "ordering",
    "receipts"
  ],
  "properties": {
    "schema_version": { "const": "pom-filecoin-bundle/0.1" },
    "storage_profile": { "const": "filecoin-onchain-cloud/car-v1" },
    "batch_ref": { "type": "string", "pattern": "^pom-[a-f0-9]{24}$" },
    "merkle_root": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "leaf_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "tree_algorithm": { "const": "sha256-domain-separated-duplicate-last" },
    "ordering": { "const": "occurred_at-asc,receipt_id-asc" },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_id", "leaf_index", "cid"],
        "properties": {
          "receipt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{15,127}$"
          },
          "leaf_index": { "type": "integer", "minimum": 0, "maximum": 9999 },
          "cid": { "type": "string", "pattern": "^bafk[a-z2-7]+$" }
        }
      }
    }
  }
}
