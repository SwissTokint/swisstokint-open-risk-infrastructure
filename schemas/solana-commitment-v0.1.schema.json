{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swisstokint.ch/schemas/solana-commitment-v0.1.schema.json",
  "title": "SwissTokint Solana Commitment Input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issuer",
    "batch_ref",
    "merkle_root",
    "manifest_hash",
    "evidence_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "pom-solana-commitment/0.1"
    },
    "issuer": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "batch_ref": {
      "type": "string",
      "pattern": "^pom-[a-f0-9]{24}$"
    },
    "merkle_root": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
