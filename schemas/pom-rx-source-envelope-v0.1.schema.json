{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swisstokint.ch/schemas/pom-rx-source-envelope-v0.1.schema.json",
  "title": "SwissTokint POM-RX Source Envelope v0.1",
  "description": "An Ed25519-signed source envelope for one exact POM-RX receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt",
    "receipt_hash",
    "source_public_key",
    "source_signature"
  ],
  "properties": {
    "schema_version": {
      "const": "pom-rx-source-envelope/0.1"
    },
    "receipt": {
      "$ref": "./pom-rx-v0.1.schema.json"
    },
    "receipt_hash": {
      "$ref": "#/$defs/sha256"
    },
    "source_public_key": {
      "type": "string",
      "minLength": 40,
      "maxLength": 256,
      "contentEncoding": "base64"
    },
    "source_signature": {
      "type": "string",
      "minLength": 80,
      "maxLength": 128,
      "contentEncoding": "base64"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
